{
  "name": "monikey-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @monikey/api & npm run dev --workspace @monikey/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace @monikey/contracts && npm run build --workspace @monikey/money && npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test --workspace @monikey/money && npm run test:unit --workspace @monikey/api",
    "test:web:unit": "tsx --test apps/web/src/shared/lib/manila-time.test.ts apps/web/src/shared/lib/pending-submissions.test.ts",
    "test:invariants": "npm run test:invariants --workspace @monikey/api",
    "test:integration": "node scripts/run-api-integration.mjs",
    "test:contracts": "npm run contracts:check",
    "test:finance": "npm run test:unit && npm run test:invariants",
    "test:e2e": "playwright test",
    "test:scale-review": "playwright test --config=playwright.scale.config.ts",
    "test:full-stack": "npm run test:e2e -- --workers=1",
    "lint": "eslint .",
    "validate": "npm run check:ci-workflow && npm run test:ci-workflow && npm run lint && npm run typecheck && npm run build && npm run test:finance && npm run test:backup-metrics && npm run test:backup-lock && npm run test:secrets-bootstrap && npm run test:release-verifier && npm run test:release-manifest && npm run test:migration-upgrade:guard && npm run test:migration-rollout-gate && npm run format:check && npm run security:secrets && npm run test:secret-scan && npm audit --audit-level=high",
    "backup:local": "node scripts/local-backup-restore.mjs backup",
    "restore:local": "node scripts/local-backup-restore.mjs restore",
    "compose:check": "docker compose -f compose.yaml -f compose.local-test.yaml config --quiet && docker compose -f compose.e2e.yaml config --quiet",
    "deploy:check": "node scripts/check-kubernetes-manifests.mjs",
    "pwa:icons": "node scripts/render-pwa-icons.mjs",
    "e2e:stack:up": "docker compose -p monikey-e2e -f compose.e2e.yaml up --build -d --wait --wait-timeout 180",
    "e2e:stack:down": "docker compose -p monikey-e2e -f compose.e2e.yaml down --volumes --remove-orphans",
    "review:local": "node scripts/local-release-review.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "check:ci-workflow": "node scripts/check-ci-workflow.mjs",
    "test:ci-workflow": "node --test scripts/check-ci-workflow.test.mjs",
    "test:secret-scan": "node --test scripts/secret-scan.test.mjs",
    "test:backup-metrics": "node --test apps/backup-metrics/server.test.mjs",
    "test:backup-lock": "node --test scripts/test-backup-lock.test.mjs",
    "test:secrets-bootstrap": "node --test scripts/create-gitops-secrets.test.mjs",
    "test:release-verifier": "node --test scripts/verify-release-main.test.mjs",
    "test:release-manifest": "node --test scripts/prisma-schema-version.test.mjs scripts/verify-release-manifest.test.mjs scripts/render-release-manifests.test.mjs",
    "test:migration-upgrade": "node scripts/test-migration-upgrade.mjs",
    "test:migration-upgrade:guard": "node --test scripts/test-migration-upgrade.test.mjs",
    "test:migration-rollout-gate": "node --test scripts/test-migration-rollout-gate.test.mjs",
    "render:release-manifests": "node scripts/render-release-manifests.mjs",
    "contracts:check": "node scripts/check-openapi.mjs",
    "api:types": "openapi-typescript \"${API_SPEC_URL:-http://localhost:3000/openapi.json}\" -o packages/contracts/src/generated/openapi.d.ts",
    "format:check": "prettier --check \"**/*.{json,md,ts,tsx,yml,yaml,html,css}\"",
    "format": "prettier --write \"**/*.{json,md,ts,tsx,yml,yaml,html,css}\"",
    "db:generate": "npm run db:generate --workspace @monikey/api",
    "db:migrate": "npm run db:migrate --workspace @monikey/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "^10.13.0",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.72.0",
    "yaml": "^2.8.3"
  },
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  }
}
