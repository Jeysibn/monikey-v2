{
  "name": "monikey-v2",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @monikey/api & npm run dev --workspace @monikey/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run build --workspace @monikey/contracts && npm run build --workspace @monikey/money && npm run typecheck --workspaces --if-present",
    "test:unit": "npm run test --workspace @monikey/money && npm run test:unit --workspace @monikey/api",
    "test:invariants": "npm run test:invariants --workspace @monikey/api",
    "test:e2e": "playwright test",
    "review:local": "node scripts/local-release-review.mjs",
    "security:secrets": "node scripts/secret-scan.mjs",
    "contracts:check": "node scripts/check-openapi.mjs",
    "api:types": "openapi-typescript \"${API_SPEC_URL:-http://localhost:3000/openapi.json}\" -o packages/contracts/src/generated/openapi.d.ts",
    "format:check": "prettier --check \"**/*.{json,md,ts,tsx,yml,yaml,html,css}\"",
    "format": "prettier --write \"**/*.{json,md,ts,tsx,yml,yaml,html,css}\"",
    "db:generate": "npm run db:generate --workspace @monikey/api",
    "db:migrate": "npm run db:migrate --workspace @monikey/api"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "1.64.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.6.2",
    "typescript": "5.9.3"
  },
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.9.0"
  }
}
