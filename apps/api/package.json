{
  "name": "@monikey/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/server.js",
    "bootstrap-owner": "tsx src/bootstrap-owner.ts",
    "seed-e2e-user": "tsx src/seed-e2e-user.ts",
    "seed-scale-review": "tsx src/seed-scale-review.ts",
    "test:unit": "tsx --test src/ledger/domain.test.ts src/repository.guardrails.test.ts src/metrics.test.ts",
    "test:invariants": "tsx --test src/finance-invariants.test.ts",
    "test:ledger": "tsx --test src/ledger/integration.test.ts",
    "test:accounts": "tsx --test src/accounts.integration.test.ts",
    "test:categories": "tsx --test src/categories.integration.test.ts",
    "test:cards": "tsx --test src/card-statements.integration.test.ts",
    "test:bills": "tsx --test src/bills.integration.test.ts",
    "test:reports": "tsx --test src/reports.integration.test.ts",
    "test:transactions": "tsx --test src/transactions.integration.test.ts src/dashboard.integration.test.ts",
    "test:transfer-crash": "tsx --test src/transfer-crash.integration.test.ts",
    "test:idempotency": "tsx --test src/idempotency.integration.test.ts",
    "db:generate": "prisma generate --config ../../prisma.config.js",
    "db:migrate": "prisma migrate deploy --config ../../prisma.config.js"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/swagger": "9.9.2",
    "@monikey/contracts": "0.1.0",
    "@monikey/money": "0.1.0",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "fastify": "5.12.7",
    "pg": "8.16.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "24.7.2",
    "@types/pg": "8.15.5",
    "dotenv": "16.6.1",
    "fast-check": "^4.10.2",
    "prisma": "7.10.1",
    "tsx": "4.20.6"
  }
}
